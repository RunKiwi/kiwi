NEXT_PUBLIC_KIWI_API_URL=http://localhost:8080

# Product analytics (optional, off by default).
#
# Leave unset — as it is here — and the browser never downloads or initializes
# posthog-js: no client, no network calls, every capture() a no-op. Self-hosted
# deployments should keep it that way.
#
# Set it and the dashboard reports the activation funnel only (signup → repo
# connected → model key added → task submitted → PR opened). Autocapture and
# session replay stay off, and no repository name, task text or credential
# value is ever sent. See src/lib/analytics.ts.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
