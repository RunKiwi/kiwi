# Binaries (repo-root only; do not match cmd/kiwi, cmd/kiwid source dirs)
/kiwi
/kiwid

# Agent session traces
.agent-traces/

# Task state logs
task_state.json
secrets.json

# Go workspaces/debug files
*.out
*.test
query

# Database
*.db
*.db-wal
*.db-shm

# Local secrets (never commit real credentials)
.env
deploy/.env
*.local.env

# Local one-command stack state (scripts/local-up.sh)
.kiwi-local/
.terraform/
*.tfplan
.terraform.lock.hcl

# stray compiled cmd binary
kms-migrate

# Local operator/deploy scripts — hold prod ids, private paths, and DB creds. Never commit.
deploy.sh
deploy-all.sh
.claude/*
# ...except shared project skills, which are documentation meant to be
# committed and used by any future session working in this repo. (A
# directory-match pattern like `.claude/` prunes the whole tree before
# git ever evaluates a negation inside it — `.claude/*` ignores direct
# children individually instead, so the negation below actually applies.)
!.claude/skills/

# Python SDK build artifacts (setup.py sdist / pip install -e leaves these)
sdk/python/build/
sdk/python/dist/
sdk/python/*.egg-info/
__pycache__/
*.py[cod]

# Node SDK pack output
sdk/node/*.tgz
